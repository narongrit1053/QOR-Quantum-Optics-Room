import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

// A floating, translucent panel over the 3D viewport.
export component Panel inherits Rectangle {
    background: Theme.panel-bg;
    border-radius: Theme.radius-panel;
    border-width: Theme.border-width;
    border-color: Theme.panel-border;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Theme.shadow;
    clip: true;
}

// Small uppercase section label.
export component SectionHeader inherits Text {
    color: Theme.text-tertiary;
    font-size: Theme.font-caption;
    font-weight: 600;
    letter-spacing: 0.6px;
    height: 24px;
    vertical-alignment: center;
}

// A rounded square holding a one-letter monogram, like a macOS sidebar icon.
export component Glyph inherits Rectangle {
    in property <string> letter;
    in property <color> tint: Theme.accent;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: tint.with-alpha(0.22);
    Text {
        text: letter;
        color: tint.brighter(0.4);
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A sidebar row with hover and selected states.
export component ListRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> dimmed;
    in property <int> depth;
    in property <color> marker: transparent;
    callback clicked();

    height: 28px;
    border-radius: 7px;
    background: selected ? Theme.accent-soft : touch.has-hover && !dimmed ? Theme.control-hover : transparent;
    animate background { duration: Theme.quick; }

    HorizontalLayout {
        padding-left: 8px + depth * 16px;
        padding-right: 8px;
        spacing: 8px;
        if marker != transparent: Rectangle {
            width: 10px;
            Rectangle {
                width: 10px;
                height: 2px;
                border-radius: 1px;
                background: marker;
            }
        }
        Text {
            text: label;
            color: dimmed ? Theme.text-tertiary : depth > 0 ? Theme.text-secondary : Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if selected: Icon { name: "check"; tint: Theme.accent; width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
        if detail != "": Text {
            text: detail;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !dimmed;
        clicked => { root.clicked(); }
    }
}

// Two or more mutually exclusive options with a sliding thumb.
// Controlled component (D22): `current` is driven by the owner and a click only emits
// `selected(i)`. The control never assigns `current` itself, so a refused choice leaves
// the thumb where it was and later updates from Rust always move it. `current < 0`
// hides the thumb.
export component SegmentedControl inherits Rectangle {
    in property <[string]> items;
    // Optional second line per segment (smaller, tertiary text).
    in property <[string]> details;
    in property <int> current;
    // Preferred segment width; in a stretching layout the segments share the width instead.
    in property <length> segment-width: 64px;
    // Smaller height and type, for compact pickers such as [mm | in].
    in property <bool> compact;
    // Panel background and drop shadow, for controls that float over the viewport.
    in property <bool> floating: true;
    in property <bool> enabled: true;
    in property <string> item-font-family: Theme.font;
    callback selected(int);

    property <length> seg: (self.width - 4px) / max(1, root.items.length);
    property <bool> has-details: root.details.length > 0;

    preferred-width: root.items.length * root.segment-width + 4px;
    min-width: root.items.length * 24px + 4px;
    height: root.compact ? 24px : root.has-details ? 40px : 30px;
    border-radius: root.compact ? 7px : 9px;
    background: root.floating ? Theme.panel-bg : Theme.control-bg;
    border-width: root.floating ? 1px : 0px;
    border-color: Theme.panel-border;
    drop-shadow-blur: root.floating ? 18px : 0px;
    drop-shadow-offset-y: root.floating ? 6px : 0px;
    drop-shadow-color: Theme.shadow;
    opacity: root.enabled ? 1 : 0.5;

    Rectangle {
        visible: root.current >= 0 && root.current < root.items.length;
        x: 2px + max(0, root.current) * root.seg;
        y: 2px;
        width: root.seg;
        height: parent.height - 4px;
        border-radius: root.compact ? 5px : 7px;
        background: Theme.control-thumb;
        drop-shadow-blur: root.floating ? 0px : 4px;
        drop-shadow-offset-y: root.floating ? 0px : 1px;
        drop-shadow-color: Theme.drop-shadow;
        animate x { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
    }

    for item[i] in root.items: Rectangle {
        x: 2px + i * root.seg;
        y: 2px;
        width: root.seg;
        height: parent.height - 4px;
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Text {
                text: item;
                color: i == root.current ? Theme.thumb-text : Theme.text-secondary;
                font-family: root.item-font-family;
                font-size: root.compact ? 11px : 12px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
                animate color { duration: Theme.quick; }
            }
            if root.has-details && root.details[i] != "": Text {
                text: root.details[i];
                color: Theme.text-tertiary;
                font-size: 10px;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
        TouchArea {
            enabled: root.enabled;
            clicked => {
                // Controlled: never assign root.current here (D22).
                if (root.current != i) {
                    root.selected(i);
                }
            }
        }
    }
}

// A rounded text button for inspector and sheet actions.
export component PillButton inherits Rectangle {
    in property <string> label;
    // Small trailing hint, such as a keyboard shortcut.
    in property <string> hint;
    in property <bool> primary;
    in property <bool> destructive;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    preferred-width: row.preferred-width;
    min-width: row.min-width;
    border-radius: 14px;
    background: !root.enabled ? Theme.control-bg
        : root.primary ? (root.destructive ? Theme.danger : Theme.accent).brighter(touch.has-hover ? 0.12 : 0)
        : root.destructive && touch.has-hover ? Theme.danger-soft
        : touch.has-hover ? Theme.control-hover.brighter(0.4) : Theme.control-bg.brighter(0.2);
    border-width: root.primary ? 0px : 1px;
    border-color: root.destructive ? Theme.danger.with-alpha(0.35) : Theme.field-border;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.quick; }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        Text {
            text: root.label;
            color: root.primary ? Theme.on-accent : root.destructive ? Theme.danger : Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.hint != "": Text {
            text: root.hint;
            color: root.primary ? Theme.on-accent-dim : Theme.text-tertiary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A round button holding a single glyph (undo, redo, add, close).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> destructive;
    in property <length> size: 30px;
    in property <length> icon-size: 15px;
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.active ? Theme.accent-soft
        : touch.has-hover && root.enabled ? (root.destructive ? Theme.danger-soft : Theme.control-hover.brighter(0.4))
        : transparent;
    animate background { duration: Theme.quick; }

    property <string> icon-name: root.icon == "+" ? "plus" : root.icon == "✕" || root.icon == "×" ? "x"
        : root.icon == "↶" ? "undo" : root.icon == "↷" ? "redo" : root.icon == "‹" ? "chevron-left"
        : root.icon == "›" ? "chevron-right" : root.icon == "🔒" ? "lock" : root.icon == "🔓" ? "unlock"
        : root.icon == "◎" ? "target" : root.icon == "▾" ? "chevron-down" : "";
    if root.icon-name != "": Icon {
        name: root.icon-name;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size * 1.1;
        height: root.icon-size * 1.1;
        tint: !root.enabled ? Theme.text-tertiary.with-alpha(0.6)
            : root.destructive && touch.has-hover ? Theme.danger
            : root.active ? Theme.accent : Theme.text;
    }
    if root.icon-name == "": Text {
        text: root.icon;
        color: !root.enabled ? Theme.text-tertiary.with-alpha(0.6)
            : root.destructive && touch.has-hover ? Theme.danger
            : root.active ? Theme.accent : Theme.text;
        font-family: Theme.font-symbol;
        font-size: root.icon-size;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// An indeterminate progress ring. It only animates while it exists, so put it behind an `if`.
export component Spinner inherits Rectangle {
    in property <color> tint: Theme.accent;
    width: 12px;
    height: 12px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 2 A 10 10 0 1 1 2 12";
        stroke: root.tint;
        stroke-width: 2px;
        fill: transparent;
        transform-rotation: (animation-tick() / 1ms) * 0.36deg;
    }
}

// A button in the floating pill toolbar.
export component ToolButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> available: true;
    callback clicked();

    height: 30px;
    width: text.preferred-width + 24px;
    border-radius: 15px;
    background: active ? Theme.accent : touch.has-hover && available ? Theme.control-hover : transparent;
    animate background { duration: Theme.quick; }

    text := Text {
        text: label;
        color: active ? Theme.on-accent : available ? Theme.text : Theme.text-tertiary;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: available;
        clicked => { root.clicked(); }
    }
}

// Label/value pair in the inspector.
export component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 26px;
    spacing: 8px;
    Text {
        text: label;
        color: Theme.text-secondary;
        font-size: Theme.font-body;
        vertical-alignment: center;
        width: 88px;
    }
    Text {
        text: value;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
        horizontal-stretch: 1;
    }
}
