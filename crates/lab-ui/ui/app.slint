// The main window (spec §6.3, §6.4). This is the contract between lab-ui and lab-app.
//
// Import graph: types.slint is a leaf; fields, inspector and overlays import it; this file
// imports all of them and re-exports the structs. Never define the structs here (that
// would make fields.slint import app.slint: "Recursive import"), and never export a
// non-Window component from here (warning "Exported component … doesn't inherit Window").

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import "../../../library/fonts/Inter-VariableFont.ttf";
import { SceneRow, LibraryRow, InspectorField, EditField, SetRow, ConstraintRow, CornerRow, ZoneRow, DoorRow, WallChoice, OutlinePreview, PreviewLabel, PresetRow, OverlayItem, PaletteItem, CatalogRow } from "types.slint";
import { Panel, SectionHeader, Glyph, ListRow, SegmentedControl, ToolButton, IconButton, PillButton, Spinner } from "components.slint";
import { EditState, TableFocus, DragState } from "fields.slint";
import { NodeInspector, PlatformInspector, RoomInspector } from "inspector.slint";
import { Sheet, PasteSheet, Toast, ProjectMenu, PresetMenu, PartMenu, ViewportOverlay, DragValueField } from "overlays.slint";
import { StackPanel } from "stack.slint";
import { ImportDialog } from "import.slint";
import { CatalogBook } from "catalog_book.slint";
import { ViewCube, CubeFaceRow } from "view_cube.slint";
import { Icon } from "icons.slint";
import { WizardPanel } from "wizard.slint";
import { CommandPalette } from "palette.slint";
import { LibraryMenu } from "library_menu.slint";
import { ShortcutSheet } from "shortcuts.slint";
import { StartPage, StartEntry } from "start_page.slint";
import { ExportSheet } from "export.slint";
import { SettingsSheet } from "settings.slint";
import { ContextMenu } from "context_menu.slint";
import { JointPanel } from "joint_panel.slint";
import { PartBox } from "part_box.slint";
import { ConstrainPanel } from "constrain_panel.slint";
import { RelationsBar, RelationChip } from "relations_bar.slint";

export { Theme }
export { SceneRow, LibraryRow, InspectorField, EditField, SetRow, ConstraintRow, CornerRow, ZoneRow, DoorRow, WallChoice, OutlinePreview, PreviewLabel, PresetRow, OverlayItem, PaletteItem, CatalogRow } from "types.slint";
// Globals, so Rust can read the edit state and move focus to a field by id.
export { EditState, TableFocus, DragState } from "fields.slint";
export { RelationChip } from "relations_bar.slint";
export { StartEntry } from "start_page.slint";

// One scene-tree row: chevron, label (double-click to rename), lock and delete on hover.
component SceneItem inherits Rectangle {
    in property <SceneRow> item;
    callback clicked();
    callback renamed(string);
    callback action(string);
    property <bool> renaming;
    property <bool> hot: row-touch.has-hover || lock-btn.hovered || iso-btn.hovered || del-btn.hovered;

    height: 28px;
    border-radius: 7px;
    background: item.selected ? Theme.accent-soft : root.hot ? Theme.control-hover : transparent;
    if item.selected: Rectangle {
        x: 0px;
        width: 3px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    row-touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { if (item.kind != 2) { root.renaming = true; } }
    }
    HorizontalLayout {
        padding-left: 4px + item.depth * 16px;
        padding-right: 4px;
        spacing: 4px;
        Rectangle {
            width: 16px;
            if item.expandable: Icon {
                name: item.expanded ? "chevron-down" : "chevron-right";
                tint: Theme.text-tertiary;
                width: 12px;
                height: 12px;
                x: 2px;
                y: (parent.height - self.height) / 2;
            }
            if item.expandable: TouchArea { clicked => { root.action("toggle"); } }
        }
        if item.is-beam: Rectangle {
            width: 10px;
            Rectangle { width: 10px; height: 2px; border-radius: 1px; background: Theme.beam; }
        }
        if !root.renaming: Text {
            text: item.label;
            color: item.depth > 1 ? Theme.text-secondary : Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.renaming: Rectangle {
            horizontal-stretch: 1;
            background: Theme.control-bg;
            border-radius: 5px;
            edit := TextInput {
                x: 4px;
                width: parent.width - 8px;
                text: item.label;
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                single-line: true;
                init => { self.focus(); self.select-all(); EditState.focused-id = "scene.rename"; EditState.text-focused = true; }
                accepted => { root.renaming = false; root.renamed(self.text); }
                changed has-focus => {
                    if (!self.has-focus && root.renaming) { root.renaming = false; root.renamed(self.text); }
                    if (!self.has-focus) { EditState.focused-id = ""; EditState.text-focused = false; }
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { self.text = item.label; root.renaming = false; return accept; }
                    reject
                }
            }
        }
        if item.detail != "" && !root.hot: Text {
            text: item.detail;
            color: Theme.text-tertiary;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
        lock-btn := IconButton {
            visible: item.kind == 0 && (root.hot || item.locked);
            icon: item.locked ? "🔒" : "🔓";
            size: 22px;
            icon-size: 12px;
            active: item.locked;
            clicked => { root.action(item.locked ? "unlock" : "lock"); }
        }
        iso-btn := IconButton {
            visible: item.kind == 1 && root.hot;
            icon: "◎";
            size: 22px;
            icon-size: 12px;
            clicked => { root.action("isolate"); }
        }
        del-btn := IconButton {
            visible: item.kind != 2 && root.hot;
            icon: "✕";
            size: 22px;
            icon-size: 11px;
            destructive: true;
            clicked => { root.action("delete"); }
        }
    }
}

export component AppWindow inherits Window {
    // ── Viewport (M0) ─────────────────────────────────────────────────────────
    in property <image> viewport-texture;
    // True from launch until the host has rendered its warm-up frames (pipelines compiled).
    in property <bool> viewport-preparing: true;
    // Name of the isolated platform (POLA-52); empty when nothing is isolated.
    in property <string> isolated-name;
    out property <length> viewport-x: viewport.x;
    out property <length> viewport-width: viewport.width;
    out property <length> viewport-height: viewport.height;

    // ── Document and sidebar ─────────────────────────────────────────────────
    in property <string> window-title;
    in property <string> project-name;
    // "1 table · 37 parts · offline"
    in property <string> project-detail;
    // Shows the "Edited" pill in the sidebar header.
    in property <bool> dirty;
    // "", "Recovered — not saved yet", "Converted from an older format", "Saving…", "Opening…"
    in property <string> document-note;
    in property <[LibraryRow]> library;
    in property <[SceneRow]> scene;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // "Undo Change Width"
    in property <string> undo-label;
    in property <string> redo-label;
    // Choice "units": 0 mm, 1 in (driven by Rust).
    in property <int> display-unit;
    // Choice "walls": 0 auto, 1 always, 2 hidden.
    in property <int> wall-display;
    // 0 none, 1 node, 2 platform, 3 room.
    in property <int> selection-kind;
    // Banner under the inspector title; "" hides it.
    in property <string> inspector-error;

    // ── Node inspector (M0) ──────────────────────────────────────────────────
    in property <string> selection-title;
    in property <string> selection-detail;
    in property <[InspectorField]> inspector;
    in property <[EditField]> node-fields;
    in property <[SetRow]> set-rows;
    in property <[ConstraintRow]> constraint-rows;
    // M9 E. Joint fields of the selected jointed node (inspector) or of the joint being placed
    // (floating panel while `joint-editing`).
    in property <string> joint-kind;
    in property <bool> joint-flip;
    in property <[EditField]> joint-fields;
    in property <bool> joint-editing;
    in property <[EditField]> beam-fields;
    in property <string> beam-text;
    in property <bool> beam-laser;
    in property <bool> beam-on;
    // M6 `view.beams` (saved in Settings).
    in property <bool> show-beams: true;
    // POLA-154 `library.show_builtin` (saved in Settings).
    in property <bool> show-builtin-parts: false;
    // POLA-154 Ctrl+F / `library.find`: focus the library search.
    public function find-part() {
        library-menu.find();
    }
    // POLA-165: the library menu (A), its Grid | List choice (Settings) and part count.
    in-out property <bool> library-open;
    in property <bool> library-list-view;
    in property <string> library-count;
    // Pointer tool: 0 select, 1 move, 2 rotate, 3 measure, 4 constrain, 5 joint.
    in-out property <int> tool;
    // Measure readout; empty hides the chip.
    in property <string> measure-text;
    // M9 D. Tool step hint (bottom centre), shown in the measure chip's place while non-empty.
    in property <string> tool-hint;
    // M9 E2. Numeric entry during a drag: open while the pointer is down, typed text, unit label.
    in-out property <bool> drag-value-open;
    in property <string> drag-value;
    in property <string> drag-value-unit;
    // A key while the field is open; true when it was used (digits, ".", "-", Backspace, Enter, Esc).
    callback drag-value-key(string) -> bool;
    // M9 D. Context menu rows (id, title, shortcut) and its position in the viewport (logical px).
    in property <[PaletteItem]> context-rows;
    in property <length> context-x;
    in property <length> context-y;
    public function open-context-menu() { context-menu.show(); }
    // M9 F. Floating part box: shown while open, its texture and title.
    in property <bool> part-box-open;
    in property <image> part-box-texture;
    in property <string> part-box-title;
    callback part-box-pointer(int, int, length, length, bool, bool, bool);
    callback part-box-scroll(length, length, length, length);
    callback part-box-close();
    property <length> part-box-x: 300px;
    property <length> part-box-y: 80px;
    // POLA-147. Constrain Components panel (docked right of the part box).
    in property <bool> constrain-open;
    in property <int> constrain-kind: -1;
    in property <string> constrain-name1;
    in property <string> constrain-geometry1;
    in property <string> constrain-name2;
    in property <string> constrain-geometry2;
    in property <int> constrain-next;
    in property <int> constrain-row: -1;
    // M9 G. Relationships bar.
    in property <[RelationChip]> relation-chips;
    callback relation-hovered(int);
    callback relation-clicked(int);
    callback relation-double-clicked(int);
    callback relation-menu(int, length, length);

    // ── Platform inspector ───────────────────────────────────────────────────
    in property <string> platform-name;
    // "Optical table · 1200 × 900 mm"
    in property <string> platform-subtitle;
    // 0 table, 1 breadboard, 2 custom
    in property <int> platform-kind;
    // 0 stainless, 1 black anodized
    in property <int> platform-surface;
    // 0 rect, 1 rounded, 2 L, 3 custom
    in property <int> platform-outline-kind;
    // platform.outline.width|depth|radius|notch_width|notch_depth (only those that apply)
    in property <[EditField]> platform-outline-fields;
    // 0..3
    in property <int> platform-notch-corner;
    in property <[CornerRow]> platform-corners;
    in property <int> platform-corner-invalid: -1;
    in property <OutlinePreview> platform-preview;
    in property <[PreviewLabel]> platform-preview-labels;
    // platform.x, platform.y, platform.rotation, platform.top_height, platform.thickness
    in property <[EditField]> platform-placement;
    // 0 none, 1 metric, 2 imperial, 3 custom
    in property <int> platform-grid-standard;
    // 0 M4, 1 M6, 2 8-32, 3 1/4-20
    in property <int> platform-thread;
    // 0 auto, 1 fixed
    in property <int> platform-origin-mode;
    // platform.grid.pitch_x|pitch_y|margin|origin_x|origin_y (shown in the given order)
    in property <[EditField]> platform-grid-fields;
    // "1,716 holes · 48 × 36 grid"
    in property <string> platform-hole-summary;
    // "Grid fixed because parts are placed on this platform" or ""
    in property <string> platform-grid-note;
    in property <[ZoneRow]> platform-zones;
    // 0 legs, 1 isolators, 2 none, 3 on platform
    in property <int> platform-support;
    // platform.support.leg_size|leg_inset|on.name|standoff
    in property <[EditField]> platform-support-fields;
    // Names of the other platforms, for the "On platform" picker.
    in property <[string]> platform-support-bases;
    in property <int> platform-node-count;
    // "3 parts lie outside the outline" or ""
    in property <string> platform-warning;
    // Current-unit groups first.
    in property <[PresetRow]> presets;

    // ── Room inspector ───────────────────────────────────────────────────────
    // "6.00 × 5.00 m · 30.0 m² · 1 door"
    in property <string> room-subtitle;
    // room.height, room.thickness (+ room.width, room.depth when rectangular)
    in property <[EditField]> room-fields;
    in property <bool> room-is-rectangle;
    in property <[CornerRow]> room-corners;
    in property <int> room-corner-invalid: -1;
    in property <OutlinePreview> room-preview;
    // Corner numbers and wall numbers.
    in property <[PreviewLabel]> room-preview-labels;
    in property <[DoorRow]> room-doors;
    in property <[WallChoice]> room-walls;

    // ── Sheet, paste sheet, toast, busy ──────────────────────────────────────
    in property <bool> sheet-open;
    in property <string> sheet-title;
    in property <string> sheet-message;
    in property <[string]> sheet-buttons;
    in property <int> sheet-default: 0;
    // -1 none
    in property <int> sheet-destructive: -1;
    // "" closed, "platform" | "room" = PasteSheet open
    in property <string> paste-target;
    // POLA-66 export sheet.
    in property <bool> export-open;
    in property <int> export-screen-width;
    in property <int> export-screen-height;
    callback export-png(int /* width */, int /* height */);
    callback export-cancel();
    in property <string> toast;
    // "" = no button
    in property <string> toast-action;
    // File I/O in flight: spinner chip, file actions disabled (editing still works).
    in property <bool> busy;

    // ── Status (M0) ──────────────────────────────────────────────────────────
    in property <bool> rendering;
    in property <string> status;
    in property <string> gpu;

    // 0 3D, 1 Top. in-out: the T/P keys assign it (M0).
    in-out property <int> view-mode: 0;
    // Top-view blueprint look (session setting, POLA-49).
    in-out property <bool> blueprint;
    // Top-view labels and dimensions (POLA-54): the toggle and the items, in logical px.
    in-out property <bool> show-labels: true;
    in property <[OverlayItem]> overlay-labels;
    in property <[OverlayItem]> overlay-dimensions;

    // ── Callbacks ────────────────────────────────────────────────────────────
    // Returns true when accepted or a no-op; false keeps the text and marks the field invalid.
    callback field-committed(string /* id */, string /* text */) -> bool;
    // Live corner/zone preview, no command.
    callback field-edited(string /* id */, string /* text */);
    callback choice-selected(string /* id */, int /* index */);
    callback action(string /* id */);
    // Command palette (POLA-65).
    in-out property <bool> palette-open;
    in property <[PaletteItem]> palette-items;
    callback palette-query(string);
    callback palette-run(string);

    // Open Recent names and the keyboard shortcut sheet (M7 C).
    in property <[string]> recent-files;
    // Start page (POLA-149).
    in-out property <bool> start-page-visible;
    in property <bool> start-page-closable;
    in property <[StartEntry]> start-recent;
    in property <string> start-error;
    in-out property <bool> shortcuts-open;
    in property <[PaletteItem]> shortcut-items;
    // Settings sheet (POLA-155): saved choices as indices (see settings.slint) and GPU rows.
    in-out property <bool> settings-open;
    in property <int> settings-quality;
    in property <int> settings-msaa;
    in property <int> settings-shadows;
    in property <int> settings-gpu;
    in property <[string]> settings-gpus;
    callback settings-apply(int, int, int, int);
    // "" ok, else error text (the sheet stays open).
    callback paste-corners(string /* target */, string /* text */) -> string;
    callback sheet-button(int);
    callback toast-action-clicked();
    callback scene-row-clicked(int /* kind */, int /* id */);
    callback scene-row-renamed(int /* kind */, int /* id */, string);
    callback scene-row-action(int /* kind */, int /* id */, string /* "delete" | "lock" | "unlock" | "toggle" */);
    // M0 viewport input. kind: 0 down, 1 up, 2 move, 3 cancel. button: 0 left, 1 right, 2 middle, 3 other.
    callback viewport-pointer(int, int, length, length, bool, bool, bool);
    callback viewport-scroll(length, length, length, length, bool /* shift */);
    callback viewport-left();
    callback view-mode-requested(int);
    // M8 view cube (view_cube.rs): faces drawn front-to-back; positions in the cube's own px.
    in property <[CubeFaceRow]> cube-faces;
    callback view-cube-hover(length, length);
    callback view-cube-clicked(length, length);
    callback view-cube-drag(length, length);
    callback view-cube-home();
    callback clear-selection();
    // Library sidebar. drag kind: 0 move, 1 drop, 2 cancel; x/y in window coordinates.
    callback library-search(string);
    callback library-toggle(string /* group */);
    callback library-drag(string /* part id */, int, length, length);
    // POLA-60: right-click on a library part ("Edit connectors…" for user-library parts).
    callback library-edit(string /* part id */);
    // POLA-162: separate libraries and filters (state lives in lab-app's LibraryState).
    // verb: step, create, new, cancel, delete, hide, add, remove, menu, type, vendor, units, hidden.
    callback library-cmd(string /* verb */, string /* part id */, string /* arg */);
    in property <[string]> library-names;
    in property <string> library-active;
    in property <string> library-type: "All";
    in property <string> library-vendor: "All";
    in property <int> library-units;
    in property <bool> library-show-hidden;
    in property <bool> library-filtered;
    in property <bool> library-menu-hidden;
    in property <[string]> library-menu-targets;
    in-out property <bool> library-naming;
    // POLA-203: what the library menu's name field does on Enter ("create", "bundle_save",
    // "bundle_renamed") and its starting text; the part menu was opened on a bundle row.
    in-out property <string> library-name-verb: "create";
    in-out property <string> library-name-default;
    in property <bool> library-menu-bundle;
    property <string> library-menu-part;
    property <length> library-menu-x;
    property <length> library-menu-y;

    // POLA-60 connector wizard (state in lab-app/src/wizard.rs).
    in property <bool> wizard-open;
    in property <string> wizard-title;
    in property <[string]> wizard-rows;
    in property <int> wizard-step;
    in property <string> wizard-message;
    in property <int> wizard-hole-kind;
    in property <string> wizard-spec;
    in property <int> wizard-gender;
    in property <string> wizard-diameter;
    in property <int> wizard-optic-kind;
    in property <[string]> wizard-optic-kinds;
    in property <string> wizard-aperture;
    in property <int> wizard-template;
    in property <int> wizard-direction;
    in property <string> wizard-wavelength;
    callback wizard-choose(int);
    callback wizard-pick(string, int);
    callback wizard-field(string, string) -> bool;
    callback wizard-confirm();
    callback wizard-back();
    callback wizard-remove(int);
    callback wizard-save();
    callback wizard-cancel();

    // Import STEP dialog (POLA-59). Step 0 closed, 1 form, 2 converting, 3 error, 4 done.
    in property <int> import-step;
    in property <string> import-file;
    in-out property <int> import-vendor;
    in-out property <int> import-up;
    in-out property <string> import-part-number;
    in-out property <string> import-name;
    in-out property <string> import-category;
    in-out property <int> import-finish;
    in property <string> import-progress;
    in property <string> import-error;
    in property <string> import-done-text;
    in property <string> import-part-id;
    in-out property <string> import-url;
    callback import-download();
    callback import-start();
    callback import-cancel();
    callback import-define-connectors(string /* part id */);
    // "Catalog…" (POLA-173).
    in-out property <bool> catalog-open;
    in property <[CatalogRow]> catalog-rows;
    in property <string> catalog-count;
    in property <[string]> catalog-categories;
    in-out property <int> catalog-category;
    in property <string> catalog-part;
    in property <string> catalog-name;
    in property <string> catalog-path;
    in property <string> catalog-description;
    in property <string> catalog-url;
    in property <string> catalog-cad-pdf;
    in property <string> catalog-step-url;
    in property <bool> catalog-listed;
    in property <[CatalogRow]> catalog-list;
    in property <bool> catalog-empty;
    callback catalog-cmd(string /* verb */, string /* arg */);

    // Beam-height stack builder (stack.slint); lab-app/src/stack.rs fills and handles it.
    in property <string> stack-optic;
    in property <string> stack-mount;
    in property <string> stack-height;
    in property <string> stack-unit;
    in property <string> stack-result;
    in property <bool> stack-fits;
    callback stack-pick(string, int);
    callback stack-height-committed(string) -> bool;
    callback stack-drag(int, length, length);
    // Right edge of the sidebar: drags left of it are not over the viewport.
    out property <length> sidebar-right: sidebar.x + sidebar.width;
    // Development hook for the gallery: an unmodified key press while no text field has
    // focus and no sheet is open. Return true to consume it. The app leaves it unset.
    callback gallery-key(string /* text */) -> bool;

    title: root.window-title;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 960px;
    min-height: 620px;
    background: Theme.window-bg;
    default-font-family: Theme.font;
    forward-focus: shortcuts;

    property <bool> modal: root.sheet-open || root.paste-target != "" || root.palette-open || root.export-open || root.shortcuts-open || root.settings-open || root.library-open || root.import-step != 0 || root.catalog-open;
    changed shortcuts-open => {
        if (!root.shortcuts-open) {
            EditState.focus-viewport += 1;
        }
    }
    changed settings-open => {
        if (!root.settings-open) {
            EditState.focus-viewport += 1;
        }
    }
    // The library was opened from the start page (POLA-169); closing it shows the page again.
    property <bool> library-browse;
    changed library-open => {
        if (!root.library-open) {
            root.library-browse = false;
            EditState.focus-viewport += 1;
        }
    }
    changed palette-open => {
        if (!root.palette-open) {
            EditState.focus-viewport += 1;
        }
    }
    property <string> unit-label: root.display-unit == 1 ? "in" : "mm";

    // EditState.focus-viewport is bumped by fields (Enter, Escape) to hand focus back.
    property <int> focus-tick: EditState.focus-viewport;
    changed focus-tick => {
        keys.focus();
    }
    // Shortcuts work from launch, and after the start page or the connector wizard opens/closes.
    init => { keys.focus(); }
    changed start-page-visible => {
        if (!root.start-page-visible) {
            EditState.focus-viewport += 1;
        }
    }
    changed wizard-open => {
        if (root.wizard-open) {
            keys.focus();
        }
    }
    changed sheet-open => {
        if (!root.sheet-open) {
            EditState.focus-viewport += 1;
        }
    }
    changed paste-target => {
        if (root.paste-target == "") {
            EditState.focus-viewport += 1;
        }
    }
    // A field in an inspector that is being swapped out must not keep focus (it would keep
    // EditState claimed). Blurring commits it through the focus-lost path.
    changed selection-kind => {
        if (EditState.focused-id != "" && EditState.focused-id != "sidebar.search") {
            EditState.focus-viewport += 1;
        }
    }

    shortcuts := FocusScope {
        forward-focus: keys;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        capture-key-pressed(event) => {
            // Ctrl+K opens the palette, also while a field is focused.
            if (event.modifiers.control && !event.modifiers.alt && (event.text == "k" || event.text == "K") && !root.sheet-open && root.paste-target == "") {
                root.action("palette.open");
                return accept;
            }
            // Ctrl+F opens the library menu with its search focused, also while a field is focused.
            if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && (event.text == "f" || event.text == "F") && (!root.modal || root.library-open)) {
                root.action("library.find");
                return accept;
            }
            // A opens the library menu (the menu's own scope closes it).
            if ((event.text == "a" || event.text == "A") && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !EditState.text-focused && !root.modal) {
                root.action("library.open");
                return accept;
            }
            // Esc cancels a part drag or click-placing (sidebar or library menu).
            if (event.text == Key.Escape && DragState.active) {
                DragState.cancelled = true;
                DragState.active = false;
                if (DragState.source == 2) { root.stack-drag(2, 0, 0); } else { library-menu.cancel(); }
                return accept;
            }
            // A sheet owns the keyboard; its own focus scope handles the keys.
            if (root.modal) {
                return reject;
            }
            if (event.modifiers.control && !event.modifiers.alt) {
                if ((event.text == "z" || event.text == "Z") && !event.modifiers.shift) {
                    if (!EditState.field-dirty) {
                        root.action("edit.undo");
                        return accept;
                    }
                    // A dirty field: let the TextInput undo its own text.
                    return reject;
                }
                if (((event.text == "z" || event.text == "Z") && event.modifiers.shift) || ((event.text == "y" || event.text == "Y") && !event.modifiers.shift)) {
                    if (!EditState.field-dirty) {
                        root.action("edit.redo");
                        return accept;
                    }
                    return reject;
                }
                // File shortcuts: blur first (a dirty field commits through its focus-lost
                // path); the app defers the file action by one event-loop turn.
                if ((event.text == "n" || event.text == "N") && !event.modifiers.shift) {
                    keys.focus();
                    root.action("file.new");
                    return accept;
                }
                if ((event.text == "o" || event.text == "O") && !event.modifiers.shift) {
                    keys.focus();
                    root.action("file.open");
                    return accept;
                }
                if (event.text == "," && !event.modifiers.shift) {
                    keys.focus();
                    root.action("app.settings");
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    keys.focus();
                    root.action(event.modifiers.shift ? "file.save_as" : "file.save");
                    return accept;
                }
                if (!EditState.text-focused && !event.modifiers.shift) {
                    if (event.text == "c" || event.text == "C") { root.action("edit.copy"); return accept; }
                    if (event.text == "x" || event.text == "X") { root.action("edit.cut"); return accept; }
                    if (event.text == "v" || event.text == "V") { root.action("edit.paste"); return accept; }
                    if (event.text == "d" || event.text == "D") { root.action("edit.duplicate"); return accept; }
                }
                return reject;
            }
            if (event.text == Key.Delete || event.text == Key.Backspace) {
                if (EditState.text-focused) {
                    return reject;
                }
                root.action("selection.delete");
                return accept;
            }
            // Arrows nudge the selected set (Shift: 5 holes, Alt: 1 mm); R / Shift+R turn it 15°.
            if (!EditState.text-focused && !event.modifiers.control && !event.modifiers.meta) {
                if (event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    if (root.selection-kind != 1) { return reject; }
                    root.action((event.modifiers.alt ? "nudge.fine:" : "nudge.step:")
                        + (event.text == Key.LeftArrow ? (event.modifiers.shift && !event.modifiers.alt ? "-5:0" : "-1:0")
                        : event.text == Key.RightArrow ? (event.modifiers.shift && !event.modifiers.alt ? "5:0" : "1:0")
                        : event.text == Key.UpArrow ? (event.modifiers.shift && !event.modifiers.alt ? "0:5" : "0:1")
                        : (event.modifiers.shift && !event.modifiers.alt ? "0:-5" : "0:-1")));
                    return accept;
                }
                // R turns +15°, Shift+R −15° (M9).
                if (!event.modifiers.alt && (event.text == "r" || event.text == "R")) {
                    root.action(event.modifiers.shift ? "tool.rotate_left" : "tool.rotate_right");
                    return accept;
                }
            }
            if (!EditState.text-focused && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                if (root.gallery-key(event.text)) {
                    return accept;
                }
            }
            reject
        }

        // ── 3D viewport (full bleed) ─────────────────────────────────────────
        viewport := Rectangle {
            // Split: both panes start right of the sidebar instead of behind it (POLA-70).
            x: root.view-mode == 2 ? root.sidebar-right : 0;
            width: parent.width - self.x;
            background: Theme.viewport-bg;

            Image {
                width: 100%;
                height: 100%;
                source: root.viewport-texture;
                image-fit: fill;
            }

            // In Split the overlay belongs to the Top pane (right half) and is clipped to it;
            // its coordinates stay in full-viewport space.
            if root.view-mode != 0 && root.show-labels: Rectangle {
                x: root.view-mode == 2 ? parent.width / 2 : 0;
                width: root.view-mode == 2 ? parent.width / 2 : parent.width;
                height: 100%;
                clip: true;
                ViewportOverlay {
                    x: -parent.x;
                    width: viewport.width;
                    height: 100%;
                    labels: root.overlay-labels;
                    dimensions: root.overlay-dimensions;
                }
            }

            // Split view (POLA-51): the seam between the 3D and Top panes.
            if root.view-mode == 2: Rectangle {
                x: parent.width / 2;
                width: 1phx;
                height: 100%;
                background: Theme.scroll-thumb;
            }

            if root.viewport-preparing: Text {
                width: 100%;
                height: 100%;
                text: "Preparing shaders…";
                color: Theme.text-secondary;
                font-size: Theme.font-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            keys := FocusScope {
                key-pressed(event) => {
                    if (root.drag-value-open && !event.modifiers.control && root.drag-value-key(event.text)) {
                        return accept;
                    }
                    if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) {
                        return reject;
                    }
                    // Shift+F first: with Shift held the text is "F", which would otherwise
                    // also match plain F.
                    if (event.modifiers.shift && (event.text == "f" || event.text == "F")) {
                        root.action("view.frame_all");
                        return accept;
                    }
                    if (event.text == "f" || event.text == "F") {
                        root.action("view.frame_selection");
                        return accept;
                    }
                    if (event.text == "t" || event.text == "T") {
                        root.view-mode = 1;
                        root.view-mode-requested(1);
                        return accept;
                    }
                    if (event.text == "p" || event.text == "P" || event.text == "3") {
                        root.view-mode = 0;
                        root.view-mode-requested(0);
                        return accept;
                    }
                    if (event.text == "?") {
                        root.action("help.shortcuts");
                        return accept;
                    }
                    if (event.text == "i" || event.text == "I") {
                        root.action("tool.measure");
                        return accept;
                    }
                    if (event.text == "m" || event.text == "M") {
                        root.action("tool.move");
                        return accept;
                    }
                    if (event.text == "j" || event.text == "J") {
                        root.action("tool.joint");
                        return accept;
                    }
                    if (event.text == "h" || event.text == "H") {
                        root.action("view.hide");
                        return accept;
                    }
                    if (event.text == "s" || event.text == "S") {
                        root.action("palette.open");
                        return accept;
                    }
                    if (event.text == Key.Escape && root.wizard-open) {
                        root.wizard-cancel();
                        return accept;
                    }
                    if (event.text == Key.Escape && root.constrain-open) {
                        root.action("cpanel.cancel");
                        return accept;
                    }
                    if (event.text == Key.Return && root.constrain-open) {
                        root.action("cpanel.ok");
                        return accept;
                    }
                    if (event.text == Key.Escape && root.joint-editing) {
                        root.action("joint.cancel");
                        return accept;
                    }
                    if (event.text == Key.Return && root.joint-editing) {
                        root.action("joint.ok");
                        return accept;
                    }
                    if (event.text == Key.Escape && (root.tool == 4 || root.tool == 5)) {
                        root.action("tool.select");
                        return accept;
                    }
                    // Esc in the measure tool re-selects it, which clears the measurement.
                    if (event.text == Key.Escape && root.tool == 3) {
                        root.action("tool.measure");
                        return accept;
                    }
                    if ((event.text == Key.F10 && event.modifiers.shift) || event.text == Key.Menu) {
                        root.action("view.context_menu");
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        if (root.isolated-name != "" && root.tool == 0) {
                            root.action("view.show_all");
                        } else {
                            root.clear-selection();
                        }
                        return accept;
                    }
                    reject
                }

                pointer := TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            keys.focus();
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.drag-value-open = false;
                        }
                        root.viewport-pointer(
                            event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 1 : event.kind == PointerEventKind.move ? 2 : 3,
                            event.button == PointerEventButton.left ? 0 : event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 3,
                            self.mouse-x,
                            self.mouse-y,
                            event.modifiers.shift,
                            event.modifiers.control,
                            event.modifiers.alt);
                    }
                    scroll-event(event) => {
                        root.viewport-scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y, event.modifiers.shift);
                        accept
                    }
                    changed has-hover => {
                        if (!self.has-hover) {
                            root.viewport-left();
                        }
                    }
                }
            }

            if root.drag-value-open: DragValueField {
                x: pointer.mouse-x + 16px;
                y: pointer.mouse-y + 16px;
                text: root.drag-value;
                unit: root.drag-value-unit;
            }

            if root.isolated-name != "": Rectangle {
                y: Theme.inset + 52px;
                x: (parent.width - self.width) / 2;
                width: banner-row.preferred-width;
                height: 32px;
                border-radius: 16px;
                background: Theme.accent-soft;
                banner-row := HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 4px;
                    spacing: 10px;
                    Text {
                        text: "Isolated: " + root.isolated-name;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                    PillButton {
                        y: 2px;
                        label: "Show all";
                        clicked => { root.action("view.show_all"); }
                    }
                }
            }

            context-menu := ContextMenu {
                x: root.context-x;
                y: root.context-y;
                rows: root.context-rows;
                chosen(id) => { root.action(id); }
            }

            if root.part-box-open: PartBox {
                // Two-way, so the constrain panel follows a dragged box (POLA-182).
                x <=> root.part-box-x;
                y <=> root.part-box-y;
                texture: root.part-box-texture;
                title: root.part-box-title;
                pointer(kind, button, x, y, shift, ctrl, alt) => { root.part-box-pointer(kind, button, x, y, shift, ctrl, alt); }
                scroll(dx, dy, x, y) => { root.part-box-scroll(dx, dy, x, y); }
                close => { root.part-box-close(); }
            }

            if root.constrain-open: ConstrainPanel {
                x: root.part-box-x + 336px + 8px;
                y: root.part-box-y;
                kind: root.constrain-kind;
                name1: root.constrain-name1;
                geometry1: root.constrain-geometry1;
                name2: root.constrain-name2;
                geometry2: root.constrain-geometry2;
                next-slot: root.constrain-next;
                selected-row: root.constrain-row;
                rows: root.constraint-rows;
                action(id) => { root.action(id); }
                field-committed(id, text) => { return root.field-committed(id, text); }
            }
        }

        // ── Left sidebar: project, library, scene ────────────────────────────
        sidebar := Panel {
            x: Theme.inset;
            y: Theme.inset;
            width: 272px;
            height: root.height - 2 * Theme.inset;

            VerticalLayout {
                padding: 14px;
                spacing: Theme.gap;

                // Header: project name, "Edited" pill, document note. Opens the project menu.
                header := Rectangle {
                    height: header-layout.preferred-height + 8px;
                    border-radius: Theme.radius-control;
                    background: header-touch.has-hover ? Theme.control-hover : transparent;
                    animate background { duration: Theme.quick; }

                    header-touch := TouchArea {
                        clicked => { project-menu.show(); }
                    }

                    header-layout := VerticalLayout {
                        x: 6px;
                        y: 4px;
                        width: parent.width - 12px;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            name-text := Text {
                                text: root.project-name;
                                color: Theme.text;
                                font-size: Theme.font-title;
                                font-weight: 650;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if root.dirty: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 18px;
                                    width: edited-text.preferred-width + 14px;
                                    border-radius: 9px;
                                    background: Theme.control-thumb;
                                    opacity: root.dirty ? 1 : 0;
                                    animate opacity { duration: Theme.quick; }
                                    edited-text := Text {
                                        text: "Edited";
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                // Icon only when the name, pill and buttons need the room.
                                property <bool> icon-only: name-text.preferred-width + (root.dirty ? 50px : 0px) + palette-text.preferred-width + 12px + 16px + 24px + 40px > header-layout.width;
                                width: self.icon-only ? 24px : palette-text.preferred-width + 12px;
                                height: 24px;
                                accessible-role: button;
                                accessible-label: "Command palette (Ctrl+K)";
                                border-radius: Theme.radius-control;
                                background: palette-touch.has-hover ? Theme.control-hover : Theme.control-bg;
                                palette-touch := TouchArea {
                                    clicked => { root.action("palette.open"); }
                                }
                                Icon { visible: parent.icon-only; x: 4px; y: 4px; name: "search"; tint: Theme.text-secondary; }
                                palette-text := Text {
                                    visible: !parent.icon-only;
                                    text: "Search  Ctrl+K";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon { name: "chevron-down"; tint: Theme.text-tertiary; }
                            }
                            // Cycles Dark, Light, High contrast.
                            VerticalLayout {
                                alignment: center;
                                theme-button := Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: Theme.radius-control;
                                    background: theme-touch.has-hover ? Theme.control-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: "Change theme";
                                    Icon { name: "theme"; tint: Theme.text-secondary; }
                                    theme-touch := TouchArea {
                                        clicked => { root.action(Theme.mode == 0 ? "view.theme.light" : Theme.mode == 1 ? "view.theme.contrast" : "view.theme.dark"); }
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.project-detail;
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            overflow: elide;
                        }
                        if root.document-note != "": Text {
                            text: root.document-note;
                            color: Theme.warning;
                            font-size: Theme.font-caption;
                            overflow: elide;
                        }
                    }

                    project-menu := ProjectMenu {
                        x: 0;
                        y: parent.height + 4px;
                        busy: root.busy;
                        recent: root.recent-files;
                        action(id) => { root.action(id); }
                    }
                }

                PillButton {
                    label: "Import STEP…";
                    clicked => { root.action("import.step"); }
                }
                PillButton {
                    label: "Import from URL…";
                    clicked => { root.action("import.url"); }
                }
                PillButton {
                    label: "Import Folder into Library…";
                    clicked => { root.action("library.import_folder"); }
                }

                PillButton {
                    label: "Library (A)";
                    clicked => { root.action("library.open"); }
                }

                StackPanel {
                    optic: root.stack-optic;
                    mount: root.stack-mount;
                    height-text: root.stack-height;
                    unit: root.stack-unit;
                    result: root.stack-result;
                    fits: root.stack-fits;
                    pick(w, s) => { root.stack-pick(w, s); }
                    height-committed(t) => { return root.stack-height-committed(t); }
                    drag(k, x, y) => { root.stack-drag(k, x, y); }
                }

                HorizontalLayout {
                    SectionHeader {
                        text: "SCENE";
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        add-button := IconButton {
                            icon: "+";
                            size: 24px;
                            icon-size: 15px;
                            clicked => { add-menu.show(); }
                        }
                        add-menu := PresetMenu {
                            x: 0;
                            y: parent.height + 4px;
                            presets: root.presets;
                            title: "Add a platform";
                            chosen(id) => { root.action("platform.add." + id); }
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    min-height: (root.height - 2 * Theme.inset) * 0.4;
                    for row in root.scene: SceneItem {
                        item: row;
                        clicked => { root.scene-row-clicked(row.kind, row.id); }
                        renamed(text) => { root.scene-row-renamed(row.kind, row.id, text); }
                        action(a) => { root.scene-row-action(row.kind, row.id, a); }
                    }
                }
            }
        }

        // ── Inspector (slides in when something is selected) ─────────────────
        inspector-panel := Panel {
            property <bool> shown: root.selection-kind != 0 && !root.wizard-open;
            property <length> content-height: root.selection-kind == 1 ? node-inspector.preferred-height
                : root.selection-kind == 2 ? platform-inspector.preferred-height
                : root.selection-kind == 3 ? room-inspector.preferred-height : 0px;
            width: Theme.inspector-width;
            height: min(root.height - 2 * Theme.inset, max(self.content-height, 80px));
            y: Theme.inset;
            x: self.shown ? root.width - self.width - Theme.inset : root.width + 24px;
            opacity: self.shown ? 1 : 0;
            animate x { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
            animate opacity { duration: Theme.smooth; }
            animate height { duration: 180ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }

            Flickable {
                mouse-drag-pan-enabled: false;
                content-height: inspector-panel.content-height;

                // The three inspectors cross-fade (180 ms) when the selection kind changes.
                node-inspector := NodeInspector {
                    y: 0;
                    height: self.preferred-height;
                    opacity: root.selection-kind == 1 ? 1 : 0;
                    visible: self.opacity > 0;
                    animate opacity { duration: 180ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
                    title: root.selection-title;
                    detail: root.selection-detail;
                    fields: root.inspector;
                    edit-fields: root.node-fields;
                    set-rows: root.set-rows;
                    constraint-rows: root.constraint-rows;
                    joint-kind: root.joint-editing ? "" : root.joint-kind;
                    joint-flip: root.joint-flip;
                    joint-fields: root.joint-fields;
                    beam-fields: root.beam-fields;
                    beam-text: root.beam-text;
                    beam-laser: root.beam-laser;
                    beam-on: root.beam-on;
                    error: root.inspector-error;
                    action(id) => { root.action(id); }
                    field-committed(id, text) => { return root.field-committed(id, text); }
                    field-edited(id, text) => { root.field-edited(id, text); }
                }

                platform-inspector := PlatformInspector {
                    y: 0;
                    height: self.preferred-height;
                    opacity: root.selection-kind == 2 ? 1 : 0;
                    visible: self.opacity > 0;
                    animate opacity { duration: 180ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
                    name: root.platform-name;
                    subtitle: root.platform-subtitle;
                    error: root.inspector-error;
                    unit: root.unit-label;
                    kind: root.platform-kind;
                    surface: root.platform-surface;
                    outline-kind: root.platform-outline-kind;
                    outline-fields: root.platform-outline-fields;
                    notch-corner: root.platform-notch-corner;
                    corners: root.platform-corners;
                    corner-invalid: root.platform-corner-invalid;
                    preview: root.platform-preview;
                    preview-labels: root.platform-preview-labels;
                    placement: root.platform-placement;
                    grid-standard: root.platform-grid-standard;
                    thread: root.platform-thread;
                    origin-mode: root.platform-origin-mode;
                    grid-fields: root.platform-grid-fields;
                    hole-summary: root.platform-hole-summary;
                    grid-note: root.platform-grid-note;
                    zones: root.platform-zones;
                    support: root.platform-support;
                    support-fields: root.platform-support-fields;
                    support-bases: root.platform-support-bases;
                    node-count: root.platform-node-count;
                    warning: root.platform-warning;
                    presets: root.presets;
                    field-committed(i, t) => { return root.field-committed(i, t); }
                    field-edited(i, t) => { root.field-edited(i, t); }
                    choice-selected(i, c) => { root.choice-selected(i, c); }
                    action(id) => { root.action(id); }
                }

                room-inspector := RoomInspector {
                    y: 0;
                    height: self.preferred-height;
                    opacity: root.selection-kind == 3 ? 1 : 0;
                    visible: self.opacity > 0;
                    animate opacity { duration: 180ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
                    subtitle: root.room-subtitle;
                    error: root.inspector-error;
                    unit: root.unit-label;
                    fields: root.room-fields;
                    is-rectangle: root.room-is-rectangle;
                    corners: root.room-corners;
                    corner-invalid: root.room-corner-invalid;
                    preview: root.room-preview;
                    preview-labels: root.room-preview-labels;
                    doors: root.room-doors;
                    walls: root.room-walls;
                    wall-display: root.wall-display;
                    field-committed(i, t) => { return root.field-committed(i, t); }
                    field-edited(i, t) => { root.field-edited(i, t); }
                    choice-selected(i, c) => { root.choice-selected(i, c); }
                    action(id) => { root.action(id); }
                }
            }
        }

        // ── Connector wizard (POLA-60; replaces the inspector while open) ────
        wizard-panel := Panel {
            width: Theme.inspector-width;
            height: min(root.height - 2 * Theme.inset, 560px);
            y: Theme.inset;
            x: root.wizard-open ? root.width - self.width - Theme.inset : root.width + 24px;
            opacity: root.wizard-open ? 1 : 0;
            animate x { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
            animate opacity { duration: Theme.smooth; }
            WizardPanel {
                title: root.wizard-title;
                rows: root.wizard-rows;
                step: root.wizard-step;
                message: root.wizard-message;
                hole-kind: root.wizard-hole-kind;
                spec: root.wizard-spec;
                gender: root.wizard-gender;
                diameter: root.wizard-diameter;
                optic-kind: root.wizard-optic-kind;
                optic-kinds: root.wizard-optic-kinds;
                aperture: root.wizard-aperture;
                template: root.wizard-template;
                direction: root.wizard-direction;
                wavelength: root.wizard-wavelength;
                choose(i) => { root.wizard-choose(i); }
                pick(id, i) => { root.wizard-pick(id, i); }
                field(id, t) => { return root.wizard-field(id, t); }
                confirm => { root.wizard-confirm(); }
                back => { root.wizard-back(); }
                remove(i) => { root.wizard-remove(i); }
                save => { root.wizard-save(); }
                cancel => { root.wizard-cancel(); }
            }
        }

        // POLA-60: one right-click menu for every library row (popups cannot be repeated).
        part-menu := PartMenu {
            x: root.library-menu-x;
            y: root.library-menu-y;
            hidden: root.library-menu-hidden;
            targets: root.library-menu-targets;
            active-library: root.library-active;
            bundle: root.library-menu-bundle;
            edit-connectors => { root.library-edit(root.library-menu-part); }
            cmd(verb, arg) => {
                root.library-cmd(verb, root.library-menu-part, arg);
                if (verb == "new") {
                    root.library-name-verb = "create";
                    root.library-name-default = "";
                    root.library-naming = true;
                }
            }
        }

        // M8 view cube: top-right of the viewport, left of the inspector; 3D only.
        if root.view-mode == 0: ViewCube {
            x: (root.wizard-open ? wizard-panel.x : inspector-panel.shown ? inspector-panel.x : root.width) - self.width - Theme.inset;
            y: Theme.inset + 44px;
            faces: root.cube-faces;
            hover(x, y) => { root.view-cube-hover(x, y); }
            clicked(x, y) => { root.view-cube-clicked(x, y); }
            drag(dx, dy) => { root.view-cube-drag(dx, dy); }
            home => { root.view-cube-home(); }
        }

        // M9 E. The joint being placed: left of the inspector, below the view cube.
        if root.joint-editing: JointPanel {
            x: (root.wizard-open ? wizard-panel.x : inspector-panel.shown ? inspector-panel.x : root.width) - self.width - Theme.inset;
            y: Theme.inset + 200px;
            kind: root.joint-kind;
            flip: root.joint-flip;
            fields: root.joint-fields;
            action(id) => { root.action(id); }
            field-committed(id, text) => { return root.field-committed(id, text); }
            field-edited(id, text) => { root.field-edited(id, text); }
        }

        // ── View switcher and units (top centre) ─────────────────────────────
        // Centred on the 3D/Top/Split control alone, so Blueprint and Labels appearing in Top do
        // not shift it.
        HorizontalLayout {
            x: min(
                sidebar.x + sidebar.width + (root.width - sidebar.x - sidebar.width - view-switch.preferred-width) / 2,
                (root.wizard-open ? wizard-panel.x : inspector-panel.shown ? inspector-panel.x : root.width) - self.preferred-width - Theme.inset);
            y: Theme.inset;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: Theme.gap;
            view-switch := SegmentedControl {
                items: ["3D", "Top", "Split"];
                current: root.view-mode;
                selected(i) => {
                    root.view-mode = i;
                    root.view-mode-requested(i);
                }
            }
            VerticalLayout {
                alignment: center;
                ToolButton {
                    label: "Beams";
                    active: root.show-beams;
                    clicked => { root.action("view.beams"); }
                }
            }
            VerticalLayout {
                alignment: center;
                ToolButton {
                    label: "Demo parts";
                    active: root.show-builtin-parts;
                    clicked => { root.action("library.show_builtin"); }
                }
            }
            // Hidden rather than removed, so the bar keeps its width and does not shift.
            VerticalLayout {
                alignment: center;
                visible: root.view-mode == 1;
                ToolButton {
                    label: "Blueprint";
                    active: root.blueprint;
                    clicked => { root.action("view.blueprint"); }
                }
            }
            VerticalLayout {
                alignment: center;
                visible: root.view-mode != 0;
                ToolButton {
                    label: "Labels";
                    active: root.show-labels;
                    clicked => { root.show-labels = !root.show-labels; }
                }
            }
            VerticalLayout {
                alignment: center;
                SegmentedControl {
                    items: ["mm", "in"];
                    compact: true;
                    segment-width: 38px;
                    current: root.display-unit;
                    selected(i) => { root.choice-selected("units", i); }
                }
            }
        }

        // ── Floating pill toolbar (bottom centre of the free viewport span) ──
        toolbar := Rectangle {
            property <length> free-span: (inspector-panel.shown ? inspector-panel.x : root.width) - (sidebar.x + sidebar.width);
            property <bool> compact: self.free-span < 550px;

            x: (sidebar.x + sidebar.width) + (self.free-span - self.width) / 2;
            y: root.height - self.height - 18px;
            width: tools.preferred-width;
            height: 42px;
            border-radius: 21px;
            background: Theme.panel-bg;
            border-width: Theme.border-width;
            border-color: Theme.panel-border;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.shadow;
            animate x { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }

            tools := HorizontalLayout {
                padding: 6px;
                spacing: 2px;
                IconButton {
                    icon: "↶";
                    enabled: root.can-undo;
                    clicked => { root.action("edit.undo"); }
                    Tooltip {
                        text: @markdown("\{root.undo-label}");
                    }
                }
                IconButton {
                    icon: "↷";
                    enabled: root.can-redo;
                    clicked => { root.action("edit.redo"); }
                    Tooltip {
                        text: @markdown("\{root.redo-label}");
                    }
                }
                Rectangle {
                    width: 9px;
                    Rectangle {
                        width: 1px;
                        height: 18px;
                        background: Theme.hairline;
                    }
                }
                ToolButton {
                    label: "Select";
                    active: root.tool == 0;
                    clicked => { root.action("tool.select"); }
                }
                if !toolbar.compact: ToolButton {
                    label: "Move";
                    active: root.tool == 1;
                    clicked => { root.action("tool.move"); }
                }
                if !toolbar.compact: ToolButton {
                    label: "Rotate";
                    active: root.tool == 2;
                    clicked => { root.action("tool.rotate"); }
                }
                if !toolbar.compact: ToolButton {
                    label: "Measure";
                    active: root.tool == 3;
                    clicked => { root.action("tool.measure"); }
                }
                if !toolbar.compact: ToolButton {
                    label: "Constrain";
                    active: root.tool == 4;
                    clicked => { root.action("tool.constrain"); }
                }
                Rectangle {
                    width: 9px;
                    Rectangle {
                        width: 1px;
                        height: 18px;
                        background: Theme.hairline;
                    }
                }
                ToolButton {
                    label: "Frame all";
                    clicked => { root.action("view.frame_all"); }
                }
            }
        }

        // ── Status chip (bottom left of the viewport, stacks above toolbar if narrow) ──
        status-chip := Rectangle {
            property <bool> stack: (self.x + status-row.preferred-width + 12px) > toolbar.x;

            x: sidebar.x + sidebar.width + Theme.inset;
            y: self.stack
                ? toolbar.y - (root.toast != "" ? 48px : 0px) - self.height - 8px
                : root.height - self.height - 18px;
            height: 26px;
            width: status-row.preferred-width;
            border-radius: 13px;
            background: Theme.panel-bg;
            border-width: Theme.border-width;
            border-color: Theme.panel-border;
            animate y { duration: Theme.smooth; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }

            status-row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                spacing: 8px;
                if root.busy: VerticalLayout {
                    alignment: center;
                    Spinner { }
                }
                if !root.busy: Rectangle {
                    width: 7px;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.rendering ? Theme.accent : Theme.ok;
                        animate background { duration: Theme.quick; }
                    }
                }
                Text {
                    text: root.status;
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
                Text {
                    text: root.gpu;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
            }
        }

        // ── Relationships bar (M9 G; above the toolbar, status and toast) ────
        if root.relation-chips.length > 0: relations-bar := RelationsBar {
            x: sidebar.x + sidebar.width + Theme.inset;
            width: toolbar.free-span - 2 * Theme.inset;
            y: toolbar.y - self.height - 84px;
            chips: root.relation-chips;
            hovered(i) => { root.relation-hovered(i); }
            clicked(i) => { root.relation-clicked(i); }
            double-clicked(i) => { root.relation-double-clicked(i); }
            menu(i, x, y) => { root.relation-menu(i, self.x + x, self.y + y); }
        }

        // ── Measure readout (bottom centre, above the toolbar) ───────────────
        if (root.tool == 3 && root.measure-text != "") || root.tool-hint != "": Rectangle {
            x: toolbar.x + (toolbar.width - self.width) / 2;
            y: toolbar.y - self.height - 12px;
            height: 26px;
            width: measure-row.preferred-width;
            border-radius: 13px;
            background: Theme.panel-bg;
            border-width: Theme.border-width;
            border-color: Theme.panel-border;
            measure-row := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.tool-hint != "" ? root.tool-hint : root.measure-text;
                    color: Theme.text;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
            }
        }

        // ── Toast (bottom centre, above the toolbar) ─────────────────────────
        toast-chip := Toast {
            x: toolbar.x + (toolbar.width - self.width) / 2;
            y: toolbar.y - self.height - 12px + self.lift;
            text: root.toast;
            action-label: root.toast-action;
            action-clicked => { root.toast-action-clicked(); }
        }

        // POLA-165: library menu (A), over the viewport and sidebar.
        library-menu := LibraryMenu {
            width: root.width;
            height: root.height;
            open <=> root.library-open;
            naming <=> root.library-naming;
            name-verb <=> root.library-name-verb;
            name-default <=> root.library-name-default;
            rows: root.library;
            active: root.library-active;
            type-label: root.library-type;
            vendor-label: root.library-vendor;
            units: root.library-units;
            show-hidden: root.library-show-hidden;
            filtered: root.library-filtered;
            list-view: root.library-list-view;
            count: root.library-count;
            browse: root.library-browse;
            search(t) => { root.library-search(t); }
            toggle(g) => { root.library-toggle(g); }
            drag(id, k, x, y) => { root.library-drag(id, k, x, y); }
            cmd(verb, part, arg) => {
                if (verb == "catalog") {
                    root.library-open = false;
                    root.action("catalog.open");
                } else {
                    root.library-cmd(verb, part, arg);
                }
            }
            part-menu(id, x, y) => {
                root.library-menu-part = id;
                root.library-cmd("menu", id, "");
                root.library-menu-x = x;
                root.library-menu-y = y;
                part-menu.show();
            }
        }

        // ── Modal sheets (last, on top, with their own focus scopes) ─────────
        Sheet {
            width: root.width;
            height: root.height;
            open: root.sheet-open;
            title: root.sheet-title;
            message: root.sheet-message;
            buttons: root.sheet-buttons;
            default-button: root.sheet-default;
            destructive: root.sheet-destructive;
            button(i) => { root.sheet-button(i); }
        }

        CatalogBook {
            width: root.width;
            height: root.height;
            open <=> root.catalog-open;
            rows: root.catalog-rows;
            count: root.catalog-count;
            categories: root.catalog-categories;
            category <=> root.catalog-category;
            part: root.catalog-part;
            part-name: root.catalog-name;
            path: root.catalog-path;
            description: root.catalog-description;
            url: root.catalog-url;
            cad-pdf: root.catalog-cad-pdf;
            step-url: root.catalog-step-url;
            listed: root.catalog-listed;
            list: root.catalog-list;
            empty: root.catalog-empty;
            cmd(verb, arg) => { root.catalog-cmd(verb, arg); }
        }

        ImportDialog {
            width: root.width;
            height: root.height;
            step: root.import-step;
            file-name: root.import-file;
            vendor <=> root.import-vendor;
            up-axis <=> root.import-up;
            part-number <=> root.import-part-number;
            part-name <=> root.import-name;
            category <=> root.import-category;
            finish <=> root.import-finish;
            progress: root.import-progress;
            error: root.import-error;
            done-text: root.import-done-text;
            part-id: root.import-part-id;
            url <=> root.import-url;
            download => { root.import-download(); }
            start => { root.import-start(); }
            cancel => { root.import-cancel(); }
            choose-another => { root.action("import.step"); }
            define-connectors(id) => { root.import-define-connectors(id); }
        }

        CommandPalette {
            width: root.width;
            height: root.height;
            open: root.palette-open;
            items: root.palette-items;
            palette-query(text) => { root.palette-query(text); }
            palette-run(id) => { root.palette-run(id); }
            palette-close => { root.palette-open = false; }
        }

        ShortcutSheet {
            width: root.width;
            height: root.height;
            open: root.shortcuts-open;
            items: root.shortcut-items;
            close => { root.shortcuts-open = false; }
        }

        SettingsSheet {
            width: root.width;
            height: root.height;
            open: root.settings-open;
            quality: root.settings-quality;
            msaa: root.settings-msaa;
            shadows: root.settings-shadows;
            gpu: root.settings-gpu;
            gpus: root.settings-gpus;
            in-use: root.gpu;
            apply(q, m, s, g) => { root.settings-apply(q, m, s, g); }
            cancel => { root.settings-open = false; }
        }

        StartPage {
            width: root.width;
            height: root.height;
            // Hidden under the library while browsing, so the menu is on top and gets the keys.
            open: root.start-page-visible && !root.library-browse && !root.catalog-open;
            closable: root.start-page-closable;
            recent: root.start-recent;
            error: root.start-error;
            action(id) => {
                if (id == "library.browse") {
                    root.library-browse = true;
                    root.library-open = true;
                } else {
                    root.action(id);
                }
            }
            close => { root.start-page-visible = false; }
        }

        PasteSheet {
            width: root.width;
            height: root.height;
            target: root.paste-target;
            apply(target, text) => { return root.paste-corners(target, text); }
            cancel => { root.action("paste.cancel"); }
        }

        ExportSheet {
            width: root.width;
            height: root.height;
            open: root.export-open;
            screen-width: root.export-screen-width;
            screen-height: root.export-screen-height;
            export(w, h) => { root.export-png(w, h); }
            cancel => { root.export-cancel(); }
        }
    }
}
