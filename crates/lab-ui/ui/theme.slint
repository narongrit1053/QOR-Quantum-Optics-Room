// Design tokens. Dark is the default: labs are dim, and a dark UI keeps attention on the scene.
// Spacing follows an 8-pt grid; radii are 14px for panels and 8px for controls.

export global Theme {
    // Surfaces
    out property <color> window-bg: #0B0C0E;
    out property <brush> viewport-bg: @radial-gradient(circle, #2A2D33 0%, #16181C 55%, #0B0C0E 100%);
    out property <color> panel-bg: #18191CE6;
    out property <color> panel-border: #FFFFFF14;
    out property <color> control-bg: #FFFFFF0F;
    out property <color> control-hover: #FFFFFF14;
    out property <color> control-thumb: #3A3B40;
    out property <color> hairline: #FFFFFF12;
    out property <color> shadow: #00000080;

    // Text
    out property <color> text: #F5F5F7;
    out property <color> text-secondary: #A1A1A6;
    out property <color> text-tertiary: #6E6E73;

    // Accent and status
    out property <color> accent: #0A84FF;
    out property <color> accent-soft: #0A84FF33;
    out property <color> ok: #30D158;
    out property <color> beam: #FF375F;

    // Geometry
    out property <length> radius-panel: 14px;
    out property <length> radius-control: 8px;
    out property <length> gap: 8px;
    out property <length> inset: 12px;

    // Type
    out property <string> font: "Segoe UI Variable Text";
    out property <length> font-body: 13px;
    out property <length> font-caption: 11px;
    out property <length> font-title: 15px;

    // Motion
    out property <duration> quick: 140ms;
    out property <duration> smooth: 260ms;
}
