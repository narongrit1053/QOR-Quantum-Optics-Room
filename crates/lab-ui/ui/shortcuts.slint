// Keyboard shortcut sheet (? key, M7 C): every action that has a shortcut, plus the mouse.

import { Theme } from "theme.slint";
import { PaletteItem } from "types.slint";

component SheetRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> group;
    in property <string> keys;
    height: 24px;
    spacing: 8px;
    Text { text: root.title; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
    Text { text: root.group; color: Theme.text-secondary; font-size: Theme.font-caption; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    Text { text: root.keys; color: Theme.text-secondary; font-size: Theme.font-body; vertical-alignment: center; }
}

export component ShortcutSheet inherits Rectangle {
    in property <bool> open;
    in property <[PaletteItem]> items;
    callback close();

    visible: root.open;
    changed open => {
        if (root.open) {
            focus-scope.focus();
        }
    }

    TouchArea {
        clicked => { root.close(); }
        scroll-event(event) => { accept }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == "?") { root.close(); return accept; }
            accept
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 520px;
        height: min(parent.height - 80px, 640px);
        background: Theme.panel-bg;
        border-radius: Theme.radius-control;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow-strong;
        clip: true;

        TouchArea { }

        Flickable {
            mouse-drag-pan-enabled: false;
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding: 16px;
                spacing: 2px;
                Text { text: "Keyboard shortcuts"; color: Theme.text; font-size: Theme.font-body; font-weight: 700; height: 28px; }
                for item in root.items: SheetRow { title: item.title; group: item.group; keys: item.shortcut; }
                Text { text: "Mouse"; color: Theme.text; font-size: Theme.font-body; font-weight: 700; height: 34px; vertical-alignment: bottom; }
                SheetRow { title: "Pan"; keys: "Middle-drag"; }
                SheetRow { title: "Orbit"; keys: "Shift+Middle-drag"; }
                SheetRow { title: "Zoom to cursor"; keys: "Wheel"; }
                SheetRow { title: "Select"; keys: "Left-click"; }
                SheetRow { title: "Move selected part (Shift free, Ctrl 1 mm)"; keys: "Left-drag selected part"; }
                SheetRow { title: "Menu"; keys: "Right-click"; }
            }
        }
    }
}
