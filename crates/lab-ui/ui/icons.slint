// Hand-drawn 24x24 stroke icons (Lucide-style; the set is not available offline). One component, picked by name.
import { Theme } from "theme.slint";

export component Icon inherits Rectangle {
    in property <string> name;
    in property <brush> tint: Theme.text;
    width: Theme.icon-size;
    height: Theme.icon-size;

    function d(n: string) -> string {
        if (n == "theme") { return "M12 3 A9 9 0 1 0 12 21 A9 9 0 0 0 12 3 Z M12 3 L12 21"; }
        if (n == "search") { return "M11 4 A7 7 0 1 0 11 18 A7 7 0 0 0 11 4 Z M16 16 L21 21"; }
        if (n == "chevron-down") { return "M6 9 L12 15 L18 9"; }
        if (n == "x") { return "M6 6 L18 18 M18 6 L6 18"; }
        if (n == "plus") { return "M12 5 L12 19 M5 12 L19 12"; }
        if (n == "trash") { return "M4 7 L20 7 M9 7 L9 4 L15 4 L15 7 M6 7 L7 20 L17 20 L18 7"; }
        if (n == "undo") { return "M9 14 L4 9 L9 4 M4 9 L14.5 9 A5.5 5.5 0 0 1 14.5 20 L11 20"; }
        if (n == "redo") { return "M15 14 L20 9 L15 4 M20 9 L9.5 9 A5.5 5.5 0 0 0 9.5 20 L13 20"; }
        if (n == "lock") { return "M5 11 L19 11 L19 21 L5 21 Z M8 11 L8 7 A4 4 0 0 1 16 7 L16 11"; }
        if (n == "unlock") { return "M5 11 L19 11 L19 21 L5 21 Z M8 11 L8 7 A4 4 0 0 1 15.5 5.5"; }
        if (n == "target") { return "M12 3 A9 9 0 1 0 12 21 A9 9 0 0 0 12 3 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 0 0 12 9 Z"; }
        if (n == "chevron-right") { return "M9 6 L15 12 L9 18"; }
        if (n == "chevron-left") { return "M15 6 L9 12 L15 18"; }
        if (n == "check") { return "M5 12 L10 17 L19 7"; }
        return "";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d(root.name);
        stroke: root.tint;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}
