// M9 F. Floating part box: a draggable panel over the viewport showing one part, rendered by
// its own viewport camera. Pointer events on the image go to the app in the image's logical px.
import { Theme } from "theme.slint";
import { Panel, IconButton } from "components.slint";

export component PartBox inherits Panel {
    in property <image> texture;
    in property <string> title;
    callback pointer(int /* 0 down, 1 up, 2 move, 3 leave */, int /* 0 left, 1 right, 2 middle */, length, length, bool, bool, bool);
    callback scroll(length, length, length, length);
    callback close();

    width: 336px;
    height: 372px;

    // Title bar: drag to move the box, close button on the right.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 44px;
        Text {
            x: 14px;
            width: parent.width - 60px;
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        move := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            moved => {
                root.x += self.mouse-x - self.pressed-x;
                root.y += self.mouse-y - self.pressed-y;
            }
        }
        IconButton {
            x: parent.width - self.width - 8px;
            y: 7px;
            icon: "✕";
            clicked => { root.close(); }
        }
    }

    Rectangle {
        x: 8px;
        y: 44px;
        width: 320px;
        height: 320px;
        border-radius: 6px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.texture;
            image-fit: fill;
        }
        TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
            pointer-event(event) => {
                root.pointer(
                    event.kind == PointerEventKind.down ? 0 : event.kind == PointerEventKind.up ? 1 : event.kind == PointerEventKind.move ? 2 : 3,
                    event.button == PointerEventButton.left ? 0 : event.button == PointerEventButton.right ? 1 : event.button == PointerEventButton.middle ? 2 : 3,
                    self.mouse-x,
                    self.mouse-y,
                    event.modifiers.shift,
                    event.modifiers.control,
                    event.modifiers.alt);
            }
            scroll-event(event) => {
                root.scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y);
                accept
            }
            changed has-hover => {
                if (!self.has-hover) {
                    root.pointer(3, 3, 0, 0, false, false, false);
                }
            }
        }
    }
}
