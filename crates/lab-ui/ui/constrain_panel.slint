// POLA-147. Constrain Components panel (Fusion layout): type, two components with their picked
// geometry, the constraints of Component 1, OK / Cancel. Docked right of the part box.
// Every click goes out as `action("cpanel.…")`; table fields as `cpanel.constraint.<i>.offset`.

import { Theme } from "theme.slint";
import { ConstraintRow } from "types.slint";
import { Panel, IconButton, PillButton } from "components.slint";
import { NumberField } from "fields.slint";

// Text labels: the UI font has no Mate/Flush glyphs (POLA-182). Disabled when the picked pair
// cannot take the kind.
component KindButton inherits Rectangle {
    in property <string> name;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    width: label.preferred-width + 16px;
    height: 32px;
    border-radius: 6px;
    background: root.active ? Theme.accent : touch.has-hover && root.enabled ? Theme.panel-border : transparent;
    border-width: 1px;
    border-color: Theme.panel-border;
    label := Text {
        text: root.name;
        color: root.active ? white : root.enabled ? Theme.text : Theme.text-tertiary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component ComponentRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> name;
    in property <string> geometry;
    in property <bool> armed;
    callback select();
    spacing: 8px;
    height: 30px;
    Text { text: root.label; color: Theme.text-secondary; width: 92px; vertical-alignment: center; }
    Text { text: root.name == "" ? "-" : root.name; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
    PillButton {
        label: root.geometry == "" ? "Select" : root.geometry;
        primary: root.armed;
        clicked => { root.select(); }
    }
}

export component ConstrainPanel inherits Panel {
    in property <int> kind; // -1 none, 0 Mate, 1 Flush, 2 Concentric, 3 Angle
    in property <string> name1;
    in property <string> geometry1;
    in property <string> name2;
    in property <string> geometry2;
    in property <int> next-slot;
    in property <int> selected-row;
    in property <[ConstraintRow]> rows;
    callback action(string /* id */);
    callback field-committed(string /* id */, string /* text */) -> bool;

    width: 380px;
    height: body.preferred-height;
    // Clicks on the panel do not reach the viewport below.
    TouchArea { }

    body := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text { text: "CONSTRAIN COMPONENTS"; color: Theme.text; font-weight: 650; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { icon: "✕"; clicked => { root.action("cpanel.cancel"); } }
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: "Type"; color: Theme.text-secondary; width: 92px; vertical-alignment: center; }
            // A picked axis rules out Mate/Flush, a picked face Concentric.
            property <bool> axis: root.geometry1 == "Axis" || root.geometry2 == "Axis";
            property <bool> face: root.geometry1 == "Face" || root.geometry2 == "Face";
            KindButton { name: "Mate"; enabled: !axis; active: root.kind == 0; clicked => { root.action("cpanel.kind.0"); } }
            KindButton { name: "Flush"; enabled: !axis; active: root.kind == 1; clicked => { root.action("cpanel.kind.1"); } }
            KindButton { name: "Concentric"; enabled: !face; active: root.kind == 2; clicked => { root.action("cpanel.kind.2"); } }
            KindButton { name: "Angle"; enabled: !(axis && face); active: root.kind == 3; clicked => { root.action("cpanel.kind.3"); } }
            Rectangle { }
        }
        ComponentRow {
            label: "Component 1";
            name: root.name1;
            geometry: root.geometry1;
            armed: root.next-slot == 0;
            select => { root.action("cpanel.select.0"); }
        }
        ComponentRow {
            label: "Component 2";
            name: root.name2;
            geometry: root.geometry2;
            armed: root.next-slot == 1;
            select => { root.action("cpanel.select.1"); }
        }
        HorizontalLayout {
            spacing: 6px;
            for h in ["Name", "Type", "Geometry", "Offset", "Flip"]: Text {
                text: h;
                color: Theme.text-tertiary;
                font-size: Theme.font-caption;
                width: h == "Offset" ? 96px : h == "Flip" ? 40px : 64px;
            }
        }
        for c in root.rows: Rectangle {
            height: 30px;
            border-radius: 4px;
            background: root.selected-row == c.index ? Theme.panel-border : transparent;
            TouchArea { clicked => { root.action("cpanel.row." + c.index); } }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "C" + (c.index + 1); color: Theme.text; width: 64px; vertical-alignment: center; }
                PillButton { label: c.kind; width: 64px; clicked => { root.action("cpanel.constraint." + c.index + ".kind"); } }
                Text { text: c.kind == "Concentric" ? "Axis" : "Face"; color: Theme.text-secondary; width: 64px; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    NumberField {
                        id: "cpanel." + c.offset.id;
                        value: c.offset.value;
                        unit: c.offset.unit;
                        field-width: 96px;
                        committed(i, t) => { return root.field-committed(i, t); }
                    }
                }
                PillButton { label: c.flip ? "✓" : " "; primary: c.flip; width: 40px; clicked => { root.action("cpanel.constraint." + c.index + ".flip"); } }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            IconButton { icon: "+"; clicked => { root.action("cpanel.add"); } }
            IconButton { icon: "×"; destructive: true; enabled: root.selected-row >= 0; clicked => { root.action("cpanel.delete"); } }
            Rectangle { }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            PillButton { label: "Cancel"; hint: "Esc"; clicked => { root.action("cpanel.cancel"); } }
            PillButton { label: "OK"; hint: "Enter"; primary: true; clicked => { root.action("cpanel.ok"); } }
        }
    }
}
